{
  "description": "injection-guard: gate raw document reads until scanned, route WebFetch through safe-fetch, scan tool output for hidden instructions, protect the guard's own files",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_hook.py\" session", "timeout": 10 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_hook.py\" prompt", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Read|WebFetch|Bash|Edit|Write|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [ { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_hook.py\" pre", "timeout": 20 } ] }
    ],
    "PostToolUse": [
      { "matcher": ".*",
        "hooks": [ { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_hook.py\" post", "timeout": 20 } ] }
    ]
  }
}
