% igresearch.sty - shared look for the injection-guard paper and the methods documentation.
% NeurIPS-preprint look: one column, US letter, Times, small-caps title, running header, author-year citations,
% bold run-in paragraph heads, no paragraph indent. Quiet colours; one accent for data, one for "harm".
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{igresearch}[2026/11/19 injection-guard research style]

\RequirePackage[letterpaper,textwidth=5.5in,textheight=9in,top=1in,headheight=12pt,headsep=25pt,footskip=30pt]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage{amsmath}
\RequirePackage{newtxtext,newtxmath}
\RequirePackage{microtype}
\RequirePackage{booktabs,tabularx,array,threeparttable,longtable}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{positioning,arrows.meta,fit,calc,shapes.geometric}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usepgfplotslibrary{groupplots}
\RequirePackage[font=small,labelfont=bf,skip=4pt]{caption}
\RequirePackage{subcaption}
\RequirePackage{enumitem}
\setlist{nosep,leftmargin=*}
\RequirePackage[round,sort&compress]{natbib}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage{xurl}

% colours: acc = data / the guard, harm = attacks that worked, mute = secondary
\definecolor{acc}{HTML}{1F4E79}
\definecolor{acc2}{HTML}{5B8DB8}
\definecolor{harm}{HTML}{B3261E}
\definecolor{ok}{HTML}{1B7F3B}
\definecolor{mute}{HTML}{6B6B6B}
\definecolor{boxbg}{HTML}{F3F6FA}
\hypersetup{colorlinks,linkcolor=acc,citecolor=acc,urlcolor=acc}

% paragraphs and headings as in the NeurIPS preprint style
\setlength{\parindent}{0pt}
\setlength{\parskip}{5.5pt}
\RequirePackage{titlesec}
\titleformat{\section}{\normalfont\large\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}{\normalfont\normalsize\bfseries}{\thesubsection}{1em}{}
\titlespacing*{\section}{0pt}{12pt plus 4pt minus 2pt}{6pt plus 2pt}
\titlespacing*{\subsection}{0pt}{9pt plus 3pt minus 2pt}{4pt plus 1pt}
\renewcommand{\paragraph}[1]{\par\textbf{#1}\hspace{0.5em}}
% title block: small caps, centred; \igrunning{} sets the running header shown from page 2
\RequirePackage{fancyhdr}
\newcommand{\igrunning}[1]{\def\ig@running{#1}}
\def\ig@running{}
\fancypagestyle{igmain}{\fancyhf{}\fancyhead[C]{\small\ig@running}\fancyfoot[C]{\thepage}\renewcommand{\headrulewidth}{0.4pt}}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\thepage}\renewcommand{\headrulewidth}{0pt}}
\pagestyle{igmain}
\renewcommand{\maketitle}{\par\begingroup
  \thispagestyle{plain}
  \vspace*{0.1in}
  {\centering{\LARGE\scshape\@title\par}\vspace{0.3in}
   {\normalsize\begin{tabular}[t]{c}\@author\end{tabular}\par}\vspace{0.12in}
   {\small\@date\par}}
  \vspace{0.25in}\endgroup\setcounter{footnote}{0}}
\renewenvironment{abstract}{\begin{center}{\large\scshape Abstract}\end{center}\vspace{-4pt}
  \begin{list}{}{\leftmargin=0.5in\rightmargin=0.5in}\item\relax}{\end{list}\vspace{6pt}}
\renewcommand{\arraystretch}{1.15}
\newcolumntype{L}{>{\raggedright\arraybackslash}X}
\newcolumntype{P}[1]{>{\raggedright\arraybackslash}p{#1}}

% one key message per section, shown in a light box
\newcommand{\takeaway}[1]{\par\smallskip\noindent\colorbox{boxbg}{\parbox{\dimexpr\linewidth-2\fboxsep}{\small\textbf{Takeaway.} #1}}\par\smallskip}
% a hypothesis line: \hyp{F1}{H0 text}{H1 text}
\newcommand{\hyp}[3]{\par\noindent\textbf{#1.}\quad $H_0$: #2\quad $H_1$: #3\par}
\newcommand{\pval}[1]{\ensuremath{p=#1}}
\newcommand{\kn}[2]{\ensuremath{#1/#2}}

\pgfplotsset{
  igbar/.style={xbar, bar width=6pt, axis x line*=bottom, axis y line*=left, y dir=reverse,
    xmajorgrids, grid style={mute!25}, tick label style={font=\scriptsize}, label style={font=\small},
    enlarge y limits=0.06, ytick=data, xmin=0},
}
\endinput
